{
  "name": "palmodmanager",
  "version": "1.7.1",
  "description": "Palworld Mod Organizer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --test integration_tests",
    "test:verbose": "cargo test --manifest-path src-tauri/Cargo.toml --test integration_tests -- --nocapture --test-threads=1",
    "clean": "node scripts/clean-cache.js",
    "dumps:check": "node scripts/sync_ue4ss_dumps.js",
    "dumps:sync": "node scripts/sync_ue4ss_dumps.js --sync",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.7",
    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/marked": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
